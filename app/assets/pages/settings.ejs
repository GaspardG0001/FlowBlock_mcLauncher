<div id="<%= __filename %>" class="main" style="display: none;">
    <div class="top">
        <div class="buttons">
            <% settingsList.forEach(file => {
                let fileName = file.split('.')
                fileName.splice(fileName.length-1,1)
                if(!isNaN(parseInt(fileName[0]))) fileName.shift()
                fileName = fileName.join('.') %>
                <button id="navsettings_<%= fileName %>" goSettings="<%= fileName %>">
                    <div class="name">
                        <span><%= lang('navsettings.'+fileName) %></span>
                        <div class="splitbg">
                            <svg style="top: 0px; left: 20px;" version="1.2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="20" height="20"><path d="m10 0v10h-10v-10zm0 0v10h-10v-10z"/><path d="m20 10v10h-10v-10zm0 0v10h-10v-10z"/></svg>
                            <svg style="bottom: 0px; right: 20px;" xmlns="http://www.w3.org/2000/svg" version="1.2" viewBox="0 0 10 10" width="10" height="10"><path d="m10 0v10h-10v-10zm0 0v10h-10v-10z"/></svg>                        
                        </div>
                    </div>
                </button>
            <% }) %>
        </div>
    </div>
    <div id="main_settings">
        <% settingsList.forEach(file => {
            let fileName = file.split('.')
            fileName.splice(fileName.length-1,1)
            if(!isNaN(parseInt(fileName[0]))) fileName.shift()
            fileName = fileName.join('.') %>
            <%- include('./settings/'+file, {__filename: fileName}) %>
        <% }) %>
    </div>
    <div class="bottom">
        <div class="back">
            <button class="largless" action="closeSettings()">
                <div class="name">
                    <span><%= lang('settings.backButton') %></span>
                    <div class="bg">
                        <svg xmlns="http://www.w3.org/2000/svg" version="1.2" viewBox="0 0 155 30" width="155" height="30"><path d="m10 20v10h-10v-10zm10 0v10h-10v-10zm10-10v10h-10v-10zm30-10v10h-10v-10zm95 20v10h-10v-10zm-10 0v10h-10v-10zm-20-20v10h-10v-10zm-45 20v10h-10v-10zm-30-20v10h-10v-10z"/></svg>
                    </div>
                </div>
            </button>
        </div>
    </div>
    <script src="assets/js/scripts/pages/settings.js"></script>
</div>
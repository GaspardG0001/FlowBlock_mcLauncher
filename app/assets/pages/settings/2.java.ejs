<div id="<%= 'settings_'+__filename %>" class="container" style="display: none;">
    <div class="column" style="padding-bottom: 8px;">
        <div class="row_setting">
            <div class="name"><%= lang('settings.maxRAM') %></div>
            <span><span serverDependent settingValue="MaxRAM"></span><span>G</span></span>
            <input serverDependent settingValue="MaxRAM" type="range" min="1" step="0.1" max="46.7">
        </div>
        <div class="row_setting">
            <div class="name"><%= lang('settings.minRAM') %></div>
            <span><span serverDependent settingValue="MinRAM"></span><span>G</span></span>
            <input serverDependent settingValue="MinRAM" type="range" min="1" step="0.1" max="46.7">
        </div>
        <div class="column_setting">
            <div class="name"><%= lang('settings.javaExecutableTitle') %></div>
            <div class="row_united">
                <input serverDependent settingValue="JavaExecutable" disabled type="text">
                <button action="openJavaExeDialog()">
                    <div class="name">
                        <span><%= lang('settings.javaExecSelButtonText') %></span>
                    </div>
                </button>
            </div>
        </div>
        <div class="column_setting">
            <div class="name"><%= lang('settings.jvmOptsTitle') %></div>
            <input serverDependent settingValue="JVMOptions" type="text">
        </div>
    </div>
</div>
<div id="<%= 'settings_'+__filename %>" class="container" style="display: none;">
    <div class="column" style="padding-bottom: 8px;">
        <div class="row_setting">
            <div class="name"><%= lang('settings.launchFullscreenTitle') %></div>
            <div class="toggle" settingValue="Fullscreen">
                <div class="bg">
                    <div class="bgbox">
                        <div class="line"></div>
                    </div>
                    <div class="bgbox">
                        <div class="circle"></div>
                    </div>
                </div>
                <div class="check"></div>
            </div>
        </div>
        <div class="row_setting">
            <div class="name"><%= lang('settings.autoConnectTitle') %></div>
            <div class="toggle" settingValue="AutoConnect">
                <div class="bg">
                    <div class="bgbox">
                        <div class="line"></div>
                    </div>
                    <div class="bgbox">
                        <div class="circle"></div>
                    </div>
                </div>
                <div class="check"></div>
            </div>
        </div>
        <div class="row_setting">
            <div class="name"><%= lang('settings.launchDetachedTitle') %></div>
            <div class="toggle" settingValue="LaunchDetached">
                <div class="bg">
                    <div class="bgbox">
                        <div class="line"></div>
                    </div>
                    <div class="bgbox">
                        <div class="circle"></div>
                    </div>
                </div>
                <div class="check"></div>
            </div>
        </div>
    </div>
</div>
<div id="<%= __filename %>" class="main" style="display: none;">
    <div class="center">
        <div class="row">
            <button class="full primary" action="launchGame()">
                <div class="name">
                    <span>
                        <%= lang('landing.playButton') %>
                    </span>
                    <div class="bg">
                        <svg xmlns="http://www.w3.org/2000/svg" version="1.2" viewBox="0 0 240 30" width="240"
                            height="30">
                            <path
                                d="m10 0v10h-10v-10zm0 0v10h-10v-10zm10 0v10h-10v-10zm0 0v10h-10v-10zm210 10v10h-10v-10zm0 0v10h-10v-10zm-20 10v10h-10v-10zm0 0v10h-10v-10zm30-10v10h-10v-10zm0 0v10h-10v-10zm-60-10v10h-10v-10zm0 0v10h-10v-10zm-150 10v10h-10v-10zm0 0v10h-10v-10zm50 10v10h-10v-10zm0 0v10h-10v-10zm-10 0v10h-10v-10zm0 0v10h-10v-10z" />
                        </svg>
                    </div>
                </div>
                <div class="skin">
                    <img draggable="false" avatar src="">
                </div>
                <div class="overlay button_overlay" launch_overlay style="display: none;">
                    <div class="center">
                        <div class="column" style="width: 100%; padding: 20px;">
                            <div launch_text class="text"></div>
                            <div class="progress_bar">
                                <div launch_percentage class="progress" style="width: 0%;"></div>
                                <div class="bg"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </button>
            <div class="column">
                <button action="openSettings()">
                    <div class="name">
                        <span>
                            <%= lang('landing.settingsButton') %>
                        </span>
                        <div class="bg">
                            <svg xmlns="http://www.w3.org/2000/svg" version="1.2" viewBox="0 0 240 30" width="240"
                                height="30">
                                <path
                                    d="m10 20v10h-10v-10zm0 0v10h-10v-10zm10 0v10h-10v-10zm0 0v10h-10v-10zm210 0v10h-10v-10zm0 0v10h-10v-10zm-70 0v10h-10v-10zm0 0v10h-10v-10zm80 0v10h-10v-10zm0 0v10h-10v-10zm-30-20v10h-10v-10zm0 0v10h-10v-10zm-180 10v10h-10v-10zm0 0v10h-10v-10zm20-10v10h-10v-10zm0 0v10h-10v-10zm10 0v10h-10v-10zm0 0v10h-10v-10z" />
                            </svg>
                        </div>
                    </div>
                </button>
                <button class="danger" action="disconnect()">
                    <div class="name">
                        <span>
                            <%= lang('landing.disconnectButton') %>
                        </span>
                        <div class="bg">
                            <svg xmlns="http://www.w3.org/2000/svg" version="1.2" viewBox="0 0 240 30" width="240"
                                height="30">
                                <path
                                    d="m10 20v10h-10v-10zm0 0v10h-10v-10zm10 0v10h-10v-10zm0 0v10h-10v-10zm210 0v10h-10v-10zm0 0v10h-10v-10zm-70 0v10h-10v-10zm0 0v10h-10v-10zm80 0v10h-10v-10zm0 0v10h-10v-10zm-30-20v10h-10v-10zm0 0v10h-10v-10zm-180 10v10h-10v-10zm0 0v10h-10v-10zm20-10v10h-10v-10zm0 0v10h-10v-10zm10 0v10h-10v-10zm0 0v10h-10v-10z" />
                            </svg>
                        </div>
                    </div>
                </button>

                <!-- Service Status Widget -->
                <div id="statusWidget" class="status-widget">
                    <div class="status-header">
                        <span class="status-dot" data-state="ok"></span>
                        <span id="statusTitle">Loading status…</span>
                    </div>

                    <div id="statusBody" class="status-body"></div>

                    <div class="status-footer">
                        <a id="statusLink" href="https://status.mcflowblock.com/" target="_blank" rel="noreferrer">See
                            full status</a>
                    </div>
                </div>

                <style>
                    /* Minimal, theme-friendly styles for the status widget */
                    .status-widget {
                        margin-top: 12px;
                        padding: 12px;
                        border-radius: 12px;
                        background: rgba(0, 0, 0, .25);
                        backdrop-filter: saturate(1.2) blur(2px)
                    }

                    .status-header {
                        display: flex;
                        align-items: center;
                        gap: 8px;
                        font-weight: 600
                    }

                    .status-dot {
                        width: 10px;
                        height: 10px;
                        border-radius: 50%;
                        display: inline-block
                    }

                    .status-dot[data-state="ok"] {
                        background: #22c55e
                    }

                    .status-dot[data-state="degraded"] {
                        background: #eab308
                    }

                    .status-dot[data-state="partial"] {
                        background: #f97316
                    }

                    .status-dot[data-state="down"] {
                        background: #ef4444
                    }

                    .status-dot[data-state="maintenance"] {
                        background: #3b82f6
                    }

                    .status-body {
                        margin-top: 8px;
                        display: flex;
                        flex-direction: column;
                        gap: 6px
                    }

                    .status-item {
                        padding: 8px;
                        border-radius: 10px;
                        background: rgba(255, 255, 255, .06);
                        border: 1px solid rgba(255, 255, 255, .08)
                    }

                    .status-item .meta {
                        opacity: .8;
                        font-size: .9em
                    }

                    .status-chips {
                        display: flex;
                        flex-wrap: wrap;
                        gap: 6px;
                        margin-top: 6px
                    }

                    .chip {
                        padding: 2px 8px;
                        border-radius: 999px;
                        font-size: .8em;
                        border: 1px solid rgba(255, 255, 255, .12)
                    }

                    .chip.ok {
                        background: rgba(34, 197, 94, .12)
                    }

                    .chip.degraded {
                        background: rgba(234, 179, 8, .12)
                    }

                    .chip.partial {
                        background: rgba(249, 115, 22, .12)
                    }

                    .chip.down {
                        background: rgba(239, 68, 68, .12)
                    }

                    .status-footer {
                        margin-top: 8px;
                        font-size: .9em;
                        opacity: .85
                    }

                    .status-footer a {
                        color: inherit;
                        text-decoration: underline
                    }
                </style>


            </div>
        </div>
    </div>
    <script src="assets/js/scripts/pages/landing.js"></script>
</div>
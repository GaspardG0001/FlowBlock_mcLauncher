<html lang="fr" xmlns="http://www.w3.org/1999/xhtml">
    <head>
        <meta charset="utf-8" http-equiv="Content-Security-Policy" content="script-src 'self' 'sha256-In6B8teKZQll5heMl9bS7CESTbGvuAt3VVV86BUQBDk='"/>
        <title><%= lang('app.title') %></title>
        <script src="./assets/js/scripts/requirements.js"></script>
        <script src="./assets/js/scripts/mcutils.js"></script>
        <script src="./assets/js/scripts/uicore.js"></script>
        <link type="text/css" rel="stylesheet" href="./assets/css/uicore.css">

        <% cssList.forEach(file => { %>
            <link type="text/css" rel="stylesheet" href="./assets/css/pages/<%= file %>">
        <% }) %>
        <style>
            body {
                transition: background-image 1s ease;
                background-image: linear-gradient(135deg, #0A1837, #152C5B);
                background-size: cover;
                -webkit-user-select: none;
            }
            #main {
                display: none;
                height: 100%;
                background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 100%);
                width: 100%;
                position: absolute;
                z-index: 10;
            }
            #main[overlay] {
                filter: blur(3px) contrast(0.9) brightness(1.0);
            }
        </style>
    </head>
        <body bkid="<%= typeof bkid !== 'undefined' ? bkid : 'default' %>">
        <%- include('frame') %>

        <!-- Gestion du chargement -->
        <div id="loading" class="main">
            <div class="center">
                <img class="bigLogo" src="https://mcflowblock.com/storage/img/logo-icon.png" alt="FlowBlock_mc icon"/>
                <p class="loadingText" id="loadingText">Initialisation...</p>
            </div>
        </div>
        <div id="main">
            <% pageList.forEach(file => {
                let fileName = file.split('.')
                fileName.splice(fileName.length-1,1)
                fileName = fileName.join('.') %>
                <%- include('./assets/pages/'+file, {__filename: fileName, settingsList: settingsList}) %>
            <% }) %>
        </div>
        <script src="./assets/js/scripts/utils.js"></script>
    </body>
</html>